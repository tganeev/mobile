<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Тень для 3D эффекта -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#33000000"
                android:endColor="#00000000"
                android:type="linear" />
            <size android:height="8dp" />
        </shape>
    </item>

    <!-- Основная полуцилиндрическая форма -->
    <item android:bottom="8dp">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#1a1a2e"
                android:centerColor="#16213e"
                android:endColor="#0f3460"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="30dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
            <stroke
                android:width="1dp"
                android:color="#44ffffff" />
        </shape>
    </item>

    <!-- Глянцевый эффект для 3D -->
    <item android:bottom="8dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#33ffffff"
                android:centerColor="#11ffffff"
                android:endColor="#00ffffff"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="30dp"
                android:bottomRightRadius="30dp" />
        </shape>
    </item>
</layer-list>