<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Панель управления периодом -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/colorSurface">

        <!-- Кнопка "Предыдущий месяц" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevMonthButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_baseline_arrow_back_24"
            app:iconTint="@android:color/white"
            app:iconPadding="0dp"
            app:cornerRadius="24dp"
            android:contentDescription="Предыдущий месяц" />

        <TextView
            android:id="@+id/periodTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Апрель 2026"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Кнопка "Следующий месяц" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextMonthButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_baseline_arrow_forward_24"
            app:iconTint="@android:color/white"
            app:iconPadding="0dp"
            app:cornerRadius="24dp"
            android:contentDescription="Следующий месяц" />
    </LinearLayout>

    <!-- Поле поиска -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_marginTop="0dp"
        android:hint="Поиск по названию книги"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:endIconMode="clear_text"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:cursorVisible="true" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- ВЕРХНИЙ ЗАГОЛОВОК ТАБЛИЦЫ (Всегда виден) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <!-- Фиксированная часть заголовка (над первым столбцом) -->
        <LinearLayout
            android:id="@+id/headerFixedColumnContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Прокручиваемая часть заголовка -->
        <HorizontalScrollView
            android:id="@+id/headerHorizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/headerDynamicColumnsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ТЕЛО ТАБЛИЦЫ (Вертикальная прокрутка) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Фиксированная колонка с данными -->
            <LinearLayout
                android:id="@+id/fixedColumnContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurface"
                android:elevation="4dp" />

            <!-- Горизонтальный скролл для остальных колонок -->
            <HorizontalScrollView
                android:id="@+id/tableScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/dynamicColumnsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- Прогресс загрузки -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Сообщение при отсутствии данных -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:text="Нет данных за выбранный период"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>