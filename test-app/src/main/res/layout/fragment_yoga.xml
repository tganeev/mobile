<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Верхняя часть (50% экрана) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ЛЕВАЯ ЧАСТЬ: Изображение человека с чакрами (только изображение) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:gravity="center">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <!-- Изображение человека с чакрами -->
                    <ImageView
                        android:id="@+id/chakraPersonImage"
                        android:layout_width="200dp"
                        android:layout_height="340dp"
                        android:src="@drawable/ic_chakra_person"
                        android:contentDescription="Человек с чакрами" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

        <!-- ВЕРТИКАЛЬНАЯ РАЗДЕЛИТЕЛЬНАЯ ЛИНИЯ -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider"
            android:layout_marginHorizontal="8dp" />

        <!-- ПРАВАЯ ЧАСТЬ: Список запущенных таймеров и управление -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Активные таймеры"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Список активных таймеров -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activeTimersRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <!-- Панель управления выбранным таймером -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/selectedTimerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Шаматха"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/selectedTimerDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Практика устойчивого внимания"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/timerDisplayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="31:00"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/timerControlsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/pauseTimerButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_baseline_pause_circle_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="?attr/colorPrimary"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Пауза" />

                    <ImageButton
                        android:id="@+id/stopTimerButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_baseline_stop_circle_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="?attr/colorPrimary"
                        android:contentDescription="Стоп" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/startTimerButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_baseline_play_circle_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Запустить" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Нижняя часть (50% экрана) - круговое меню -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E">

        <org.readium.r2.testapp.yoga.CircularMenuView
            android:id="@+id/circularMenuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp" />

    </FrameLayout>

</LinearLayout>