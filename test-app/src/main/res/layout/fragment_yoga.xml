<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Верхняя часть (50% экрана) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ЛЕВАЯ ЧАСТЬ: Панель управления таймером -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Управление таймером"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/selectedTimerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Випашьяна"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/selectedTimerDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Практика осознанного наблюдения"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <!-- Таймер с обратным отсчётом -->
                <TextView
                    android:id="@+id/timerDisplayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:00"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp" />

                <!-- Кнопки управления с иконками -->
                <LinearLayout
                    android:id="@+id/timerControlsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- Кнопка Пауза (две полоски) -->
                    <ImageButton
                        android:id="@+id/pauseTimerButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_baseline_pause_circle_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="?attr/colorPrimary"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Пауза" />

                    <!-- Кнопка Стоп (квадратик) -->
                    <ImageButton
                        android:id="@+id/stopTimerButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_baseline_stop_circle_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="?attr/colorPrimary"
                        android:contentDescription="Стоп" />

                </LinearLayout>

                <!-- Кнопка запуска (стрелочка play) -->
                <ImageButton
                    android:id="@+id/startTimerButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_baseline_play_circle_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="?attr/colorPrimary"
                    android:contentDescription="Запустить" />

            </LinearLayout>

        </LinearLayout>

        <!-- ВЕРТИКАЛЬНАЯ РАЗДЕЛИТЕЛЬНАЯ ЛИНИЯ -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?android:attr/listDivider"
            android:layout_marginHorizontal="8dp" />

        <!-- ПРАВАЯ ЧАСТЬ: Список запущенных таймеров -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Активные таймеры"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activeTimersRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Нижняя часть (50% экрана) - круговое меню -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E">

        <org.readium.r2.testapp.yoga.CircularMenuView
            android:id="@+id/circularMenuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp" />

    </FrameLayout>

</LinearLayout>