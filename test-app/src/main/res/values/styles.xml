<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">

    </style>

    <!-- Стиль для круглой фотографии -->
    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="colorPrimary">#00CC00</item>

    </style>

    <!-- Стиль для скруглённого диалога -->
    <style name="RoundedDialogTheme" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@drawable/dialog_rounded_background</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>